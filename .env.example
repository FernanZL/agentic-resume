# Copy to .env and fill in. Every setting is read in backend/settings.py.

# Models (https://openrouter.ai/keys). One model for every role, or override per role.
OPENROUTER_API_KEY=
MODEL_DEFAULT=openai/gpt-6-luna
# MODEL_CONCIERGE=   MODEL_INTAKE=   MODEL_RESEARCHER=   MODEL_ANALYST=   MODEL_WRITER=   MODEL_CRITIC=

# Web search for the company and market researchers (https://tavily.com). Optional.
TAVILY_API_KEY=

# Postgres. Set by docker-compose for local use; Supabase session pooler URL in production.
# Empty: a local SQLite file with in-memory checkpoints (no resume after restart).
# DATABASE_URL=postgresql://user:password@host:5432/postgres

# Public demo guards
DEMO_PASSCODE=
MAX_DAILY_COST_USD=2

# Tracing (https://langfuse.com). Optional.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
